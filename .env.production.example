# Production environment template for the single-VPS Docker Compose deployment
# (docker-compose.prod.yml).
#
# Copy to .env.production and fill in real values. NEVER commit the filled-in
# file - .env.production is already covered by .gitignore's `.env.*` pattern
# (except this .example file). Every placeholder below is a dummy value or an
# empty string; nothing here is a usable secret.
#
# See docs/06_Operations/Production_Environment_Variables_Guide.md for a full
# explanation of each variable.

# =============================================================================
# MANDATORY - the stack will not run correctly (or will run insecurely)
# without these being set to real, non-default values.
# =============================================================================

# --- Domains / TLS (see docs/06_Operations/Domain_and_HTTPS_Guide.md) -------
# Point A/AAAA DNS records at the VPS for each domain before starting Caddy.
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
WIDGET_DOMAIN=widget.example.com
TLS_EMAIL=ops@example.com

# --- Database ----------------------------------------------------------------
POSTGRES_DB=conversa
POSTGRES_USER=conversa
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://conversa:REPLACE_WITH_STRONG_RANDOM_PASSWORD@postgres:5432/conversa

# --- Redis ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Application origins / mode ------------------------------------------
APP_ENV=production
WEB_ORIGIN=https://app.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# --- Session / auth secrets (each MUST be a unique high-entropy value) ----
# Generate every secret below with: openssl rand -hex 32
AUTH_SESSION_HASH_SECRET=REPLACE_WITH_UNIQUE_SECRET
RATE_LIMIT_IDENTITY_SECRET=REPLACE_WITH_UNIQUE_SECRET
PUBLIC_SESSION_TOKEN_HASH_SECRET=REPLACE_WITH_UNIQUE_SECRET
PUBLIC_MESSAGE_IDEMPOTENCY_HASH_SECRET=REPLACE_WITH_UNIQUE_SECRET

# --- Uploaded document storage --------------------------------------------
LOCAL_UPLOAD_ROOT=/app/apps/api/local_uploads

# --- Widget public origins (must be real HTTPS origins, no localhost) -----
WIDGET_RELEASE_ENVIRONMENT=production
WIDGET_RELEASE_CHANNEL=stable
WIDGET_PUBLIC_ORIGIN=https://widget.example.com
WIDGET_PUBLIC_API_ORIGIN=https://api.example.com
WIDGET_SDK_PUBLIC_ORIGIN=https://widget.example.com
PUBLIC_WIDGET_ASSET_BASE_URL=https://widget.example.com

# --- Embedding / generation providers --------------------------------------
# "local-mock" / "mock" are non-production placeholders (see mandatory item
# below - do not launch publicly on mock providers, only for a controlled
# early-access cohort with the same guardrail thresholds already validated in
# the 83-case golden evaluation). Replace with your real providers before
# opening broad public access.
EMBEDDING_PROVIDER=local-mock
EMBEDDING_MODEL=local-mock-v1
EMBEDDING_DIMENSION=1536
DEFAULT_AI_PROVIDER_KEY=mock
DEFAULT_AI_MODEL_KEY=mock-grounded-answer

# =============================================================================
# OPTIONAL - safe launch defaults exist; override only if you need to change
# behaviour.
# =============================================================================

# Allowed cross-origin caller for the authenticated web app's API calls. The
# API only supports a single configured origin today (see WEB_ORIGIN above
# and the security audit note on CORS in the launch report) - there is no
# separate multi-origin allowlist to set here.
LOG_LEVEL=info
API_V1_PREFIX=/api/v1
AUTH_SESSION_DAYS=7
AUTH_REMEMBER_SESSION_DAYS=30
AUTH_PASSWORD_RESET_MINUTES=30
RATE_LIMIT_REDIS_PREFIX=rate
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=0.2
RATE_LIMIT_LOCAL_FALLBACK_ENABLED=false
TRUSTED_PROXY_NETWORKS=172.16.0.0/12
MAX_UPLOAD_BYTES=10485760
CHUNK_SIZE_WORDS=300
CHUNK_OVERLAP_WORDS=50
RETRIEVAL_MAX_CONTEXT_CHUNKS=10
RETRIEVAL_MAX_CONTEXT_CHARS=12000
RETRIEVAL_MIN_SIMILARITY_SCORE=0.0
AI_REQUEST_TIMEOUT_SECONDS=30
PUBLIC_WIDGETS_ENABLED=true
PUBLIC_WIDGET_MESSAGES_ENABLED=true
PUBLIC_WIDGET_PILOT_ENFORCEMENT_ENABLED=false
PUBLIC_WIDGET_PILOT_ALLOWLIST=
PUBLIC_MESSAGE_MAX_CHARACTERS=4000
PUBLIC_MESSAGE_MAX_BYTES=12288
PUBLIC_MESSAGE_DAILY_MESSAGE_QUOTA=0
PUBLIC_MESSAGE_DAILY_TOKEN_QUOTA=0
PUBLIC_MESSAGE_DAILY_COST_QUOTA=

# --- Evaluation / guardrail thresholds (defaults match the validated launch
# thresholds in docs/04_Engineering/Evaluation_Success_Criteria.md; only
# change these if you have re-run and re-approved the golden evaluation
# against the new numbers) --------------------------------------------------
EVAL_MIN_RETRIEVAL_HIT_RATE=0.9
EVAL_MIN_CITATION_COVERAGE=0.95
EVAL_MAX_FALLBACK_RATE_ON_ANSWERABLE=0.1
EVAL_MIN_CORRECT_FALLBACK_RATE_ON_UNANSWERABLE=0.95
EVAL_MAX_P95_LATENCY_MS=8000
EVAL_MAX_REGRESSION_TOLERANCE=0.05

# =============================================================================
# OBSERVABILITY - only needed if you additionally bring up
# docker-compose.observability.yml (OTel Collector/Prometheus/Loki/Tempo/
# Grafana - see docs/06_Operations/Grafana_Prometheus_Loki_Tempo_VPS_Guide.md).
# Not required for the core product, which runs fully without this stack.
# =============================================================================
# Generate with: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# =============================================================================
# BILLING - Stripe (see docs/06_Operations/Stripe_Setup_Checklist.md)
# Leave STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET empty to launch without
# billing enforcement (checkout/portal return 400, webhook returns 503); the
# rest of the product functions normally. Fill in once you are ready to sell.
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
BILLING_TRIAL_PERIOD_DAYS=7

# =============================================================================
# DEVELOPMENT-ONLY - do not set these in production; listed here only so
# their absence is visible. Leave unset.
# =============================================================================
# NEXT_PUBLIC_DEVELOPMENT_ORGANISATION_ID=
# NEXT_PUBLIC_DEVELOPMENT_WORKSPACE_ID=
# NEXT_PUBLIC_DEVELOPMENT_USER_EMAIL=
# NEXT_PUBLIC_DEVELOPMENT_ROLE=
# MOCK_PROVIDER_FAILURE_MODE=disabled

# =============================================================================
# FUTURE AZURE VARIABLES - not used by docker-compose.prod.yml. Kept here as a
# reference so the two deployment targets share one documented variable
# surface; see docs/06_Operations/Future_Azure_Migration_Notes.md. Leave unset
# on the VPS deployment.
# =============================================================================
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# AZURE_MONITOR_OPEN_TELEMETRY_ENABLED=false
# AZURE_MONITOR_REQUIRE_CONNECTION_STRING=false
# AZURE_MONITOR_SAMPLING_RATIO=1.0
